<Window x:Class="PogodaAplikacja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PogodaAplikacja"
        mc:Ignorable="d"
        Title="Zegar" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="MediumPurple"/>
        </Grid.Background>
        <TextBlock Text="GG:MM:SS" x:Name="time" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="64" Margin="0,95,0,0" FontStyle="Italic" Foreground="PeachPuff"/>
        <TextBlock Text="dd.mm.yyyy" x:Name="date" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23" Foreground="PeachPuff"/>
        <TextBlock Text="GG:MM:SS" x:Name="tokyoTime" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="64" Margin="0,232,0,0" FontStyle="Italic" Foreground="PeachPuff"/>
    </Grid>
</Window>
