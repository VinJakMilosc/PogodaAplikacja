<Window x:Class="PogodaAplikacja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PogodaAplikacja"
        mc:Ignorable="d"
        Title="Zegar" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="MediumPurple"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <TextBlock Text="GG:MM:SS" x:Name="time" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="64" Margin="15,95,0,0" FontStyle="Italic" Foreground="PeachPuff" Height="85" Width="284"/>
            <TextBlock Text="dd.mm.yyyy" x:Name="date" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23" Foreground="PeachPuff" Height="31" Width="120"/>
        </StackPanel>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="GG:MM:SS" HorizontalAlignment="Center" x:Name="tokyoTime" Margin="15,95,0,0" Foreground="PeachPuff" Height="800" Width="284" FontSize="60" FontStyle="Italic"/>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0, 40,0,0">
            <TextBlock Text="Pogoda:" HorizontalAlignment="Center"/>
            <Button Content="Warszawa" Margin="15,10,10,10" Click="DaneWarszawa"/>
            <TextBlock Text="Pogoda:" HorizontalAlignment="Center"/>
            <Button Content="Tokio" Margin="15,10,15,10"/>
        </StackPanel>

    </Grid>
</Window>
